{
  "name": "automiq",
  "version": "1.0.0",
  "description": "TypeScript n8n clone with Prisma, Postgres, Redis, BullMQ",
  "main": "dist/src/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "db:migrate": "prisma migrate dev --name init || psql $DATABASE_URL -f prisma/manual-migrate.sql",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset --force",
    "db:migrate:sql": "psql $DATABASE_URL -f prisma/manual-migrate.sql"
  },
  "dependencies": {
     "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/pg": "^8.20.0",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.3",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^3.0.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.7.4",
    "@types/node-cron": "^3.0.11",
    "prisma": "^7.8.0",
    "typescript": "^6.0.3"
  }
}
